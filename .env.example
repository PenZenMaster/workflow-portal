# Workflow Portal — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# REQUIRED in production. Generate with one of:
#   PowerShell:  -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
#   Node REPL:   require('crypto').randomBytes(32).toString('hex')
# Must be at least 32 characters of high-entropy random data.
SESSION_SECRET=replace-me-with-a-long-random-hex-string

# Port the server listens on. cPanel's "Setup Node.js App" usually injects PORT
# automatically — leave commented in production unless you know better.
# PORT=5000

# NODE_ENV controls cookie security. Production sets Secure cookies (HTTPS only)
# and refuses to start without SESSION_SECRET. cPanel Node.js Selector sets this
# automatically when you choose "Production" in the app settings.
# NODE_ENV=production

# IMPORTANT for cPanel deployments: set both paths to a folder OUTSIDE the app
# root so deploys never overwrite your database. Recommended:
#   DATA_DB_PATH=../persistent/data.db
#   SESSION_DB_PATH=../persistent/sessions.db
# Create the folder once via SSH: mkdir -p ~/persistent
# Paths are resolved relative to the process working directory (app root).
# DATA_DB_PATH=../persistent/data.db
# SESSION_DB_PATH=../persistent/sessions.db

# --- Password reset ---------------------------------------------------------
# Required for the "Forgot password?" feature. Use the cPanel email account
# created for the portal. Port 465 = SSL (recommended). Port 587 = STARTTLS.
# SMTP_HOST=portal.fullmetaljacketseo.com
# SMTP_PORT=465
# SMTP_USER=security@portal.fullmetaljacketseo.com
# SMTP_PASS=replace-with-email-account-password

# Base URL used to build the reset link included in the email.
# In production this must be the public URL of the portal (no trailing slash).
# BASE_URL=https://portal.fullmetaljacketseo.com
