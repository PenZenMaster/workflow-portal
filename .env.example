# Workflow Portal — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# REQUIRED in production. Generate with one of:
#   PowerShell:  -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
#   Node REPL:   require('crypto').randomBytes(32).toString('hex')
# Must be at least 32 characters of high-entropy random data.
SESSION_SECRET=replace-me-with-a-long-random-hex-string

# Port the server listens on. cPanel's "Setup Node.js App" usually injects PORT
# automatically — leave commented in production unless you know better.
# PORT=5000

# NODE_ENV controls cookie security. Production sets Secure cookies (HTTPS only)
# and refuses to start without SESSION_SECRET. cPanel Node.js Selector sets this
# automatically when you choose "Production" in the app settings.
# NODE_ENV=production

# Optional: override SQLite paths. Defaults to data.db and sessions.db in the
# project root. Useful if cPanel restricts where you can write.
# SESSION_DB_PATH=sessions.db
