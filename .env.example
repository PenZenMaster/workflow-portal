# Workflow Portal — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# REQUIRED in production. Generate with one of:
#   PowerShell:  -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
#   Node REPL:   require('crypto').randomBytes(32).toString('hex')
# Must be at least 32 characters of high-entropy random data.
SESSION_SECRET=replace-me-with-a-long-random-hex-string

# Port the server listens on. cPanel's "Setup Node.js App" usually injects PORT
# automatically — leave commented in production unless you know better.
# PORT=5000

# NODE_ENV controls cookie security. Production sets Secure cookies (HTTPS only)
# and refuses to start without SESSION_SECRET. cPanel Node.js Selector sets this
# automatically when you choose "Production" in the app settings.
# NODE_ENV=production

# IMPORTANT for cPanel deployments: set both paths to a folder OUTSIDE the app
# root so deploys never overwrite your database. Recommended:
#   DATA_DB_PATH=../persistent/data.db
#   SESSION_DB_PATH=../persistent/sessions.db
# Create the folder once via SSH: mkdir -p ~/persistent
# Paths are resolved relative to the process working directory (app root).
# DATA_DB_PATH=../persistent/data.db
# SESSION_DB_PATH=../persistent/sessions.db

# --- Password reset ---------------------------------------------------------
# Required for the "Forgot password?" feature. Use the cPanel email account
# created for the portal. Port 465 = SSL (recommended). Port 587 = STARTTLS.
# SMTP_HOST=portal.fullmetaljacketseo.com
# SMTP_PORT=465
# SMTP_USER=security@portal.fullmetaljacketseo.com
# SMTP_PASS=replace-with-email-account-password

# Base URL used to build the reset link included in the email.
# In production this must be the public URL of the portal (no trailing slash).
# BASE_URL=https://portal.fullmetaljacketseo.com

# --- Perplexity AI (prompt runs) -------------------------------------------
# Required to run prompts through Perplexity Sonar. Get a key at
# perplexity.ai/settings/api. Optional daily spend cap (default $10).
# PERPLEXITY_API_KEY=pplx-...
# PERPLEXITY_DAILY_USD_LIMIT=10

# --- Additional AI Platform API Keys -----------------------------------------
# Each key enables that platform as a query target in Runs.
# Omit any key to disable that platform — it simply won't appear as an option.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_AI_API_KEY=AIza...          (Gemini — distinct from GA4 OAuth)
# GROQ_API_KEY=gsk_...               (Llama via Groq — free tier available)
# MISTRAL_API_KEY=...
# DEEPSEEK_API_KEY=sk-...

# --- RankRocket MCP (Site Insights workflow card, read-only) ----------------
# Requires ANTHROPIC_API_KEY above. Bearer token for rankrocket-mcp's /mcp
# endpoint — reuse the same token already configured for the rankrocket-mcp
# deployment / your Claude Desktop or Claude Code MCP client config, don't
# generate a new one unless you intend to update rankrocket-mcp's own env too.
# RANKROCKET_MCP_TOKEN=...
# RANKROCKET_MCP_URL=https://mcp.fullmetaljacketseo.com/mcp

# --- Google Analytics 4 (AI traffic) ----------------------------------------
# OAuth 2.0 credentials for GA4 integration. Create at:
#   console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Enable the Google Analytics Data API in the same project.
# Add the redirect URI to Authorized redirect URIs in the credential settings.
#
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REDIRECT_URI=https://portal.fullmetaljacketseo.com/api/oauth/google/callback
